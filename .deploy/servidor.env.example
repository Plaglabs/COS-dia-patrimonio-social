# A qué servidor despliega .deploy/desplegar.sh. Cópialo a .deploy/servidor.env
# (que no se versiona) y rellénalo.

# usuario@servidor, o un Host de ~/.ssh/config (para puerto, llave, etc.).
DEPLOY_SSH=usuario@servidor

# Dónde está clonado el repositorio, relativo al home del usuario del servidor.
DEPLOY_DIR=dps-laravel
